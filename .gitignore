# Flox runtime state (regenerated on every activation)
.flox/run/
.flox/cache/
.flox/log/
.flox/lib/

# flox build output symlinks
result
result-*

# Only id's freely redistributable shareware doom1.wad is tracked.
# Commercial DOOM.WAD / DOOM2.WAD must never be committed.
wads/*.wad
wads/*.WAD
wads/*.zip
!wads/doom1.wad
