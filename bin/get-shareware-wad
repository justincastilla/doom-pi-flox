#!/usr/bin/env bash
# Fetch id Software's freely redistributable shareware IWAD (Episode 1,
# "Knee-Deep in the Dead") into ./wads/doom1.wad, then play it with
#   DOOM_IWAD=doom1.wad flox activate -- doom
#
# Freedoom already ships in the environment, so this is optional. It is here
# because "the real E1M1" is a better conversation starter at a booth.
#
# The download host is configurable; the checksum is not. The v1.9 shareware
# doom1.wad has a well-known MD5 and we refuse anything else.
set -euo pipefail

WADS_DIR="${FLOX_ENV_PROJECT:-$(cd "$(dirname "$0")/.." && pwd)}/wads"
URL="${DOOM1_WAD_URL:-https://www.doomworld.com/3ddownloads/ports/shareware_doom_iwad.zip}"
EXPECTED_MD5="f0cefca49926d00903cf57551d901abe"

mkdir -p "$WADS_DIR"
if [ -f "$WADS_DIR/doom1.wad" ]; then
  echo "get-shareware-wad: $WADS_DIR/doom1.wad already present"
  exit 0
fi

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
echo "get-shareware-wad: downloading $URL"
curl -fL --retry 3 -o "$tmp/download" "$URL"

case "$URL" in
  *.zip|*.ZIP)
    ( cd "$tmp" && unzip -q -o download )
    found="$(find "$tmp" -iname 'doom1.wad' | head -n1)"
    ;;
  *)
    found="$tmp/download"
    ;;
esac

if [ -z "${found:-}" ] || [ ! -f "$found" ]; then
  echo "get-shareware-wad: no doom1.wad inside the download" >&2
  exit 1
fi

actual="$(md5sum "$found" | cut -d' ' -f1)"
if [ "$actual" != "$EXPECTED_MD5" ]; then
  echo "get-shareware-wad: checksum mismatch (got $actual, expected $EXPECTED_MD5). Refusing to install." >&2
  exit 1
fi

cp "$found" "$WADS_DIR/doom1.wad"
echo "get-shareware-wad: installed $WADS_DIR/doom1.wad"
echo "play it with:  DOOM_IWAD=doom1.wad flox activate -- doom"
