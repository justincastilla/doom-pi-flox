#!/usr/bin/env bash
# Launch DOOM from the Flox environment.
#
#   flox activate -- doom                      # 1993 shareware Episode 1 in Crispy Doom
#   flox activate -- doom -warp 1 3 -skill 4   # any engine flag passes through
#   DOOM_IWAD=DOOM.WAD flox activate -- doom   # your own registered copy, from ./wads
#
# Everything here is plain environment plumbing; the engine comes from the
# Flox manifest (.flox/env/manifest.toml), the WAD from ./wads.
set -euo pipefail

if [ -z "${FLOX_ENV:-}" ]; then
  echo "doom: not inside the Flox environment. Run: flox activate -- doom" >&2
  exit 1
fi

: "${DOOM_PORT:=crispy-doom}"
: "${DOOM_IWAD:=doom1.wad}"

# Belt and braces: the activation hook sets this, but a stale shell may not have it.
: "${DOOMWADPATH:=${FLOX_ENV_PROJECT:-$PWD}/wads}"
export DOOMWADPATH

is_raspberry_pi() {
  [ -r /proc/device-tree/model ] && tr -d '\0' < /proc/device-tree/model | grep -qi "raspberry pi"
}

# Video backend selection. SDL picks the right one itself on macOS and on a
# Linux desktop. The one case it can't guess: Linux with no Wayland/X11
# session (Raspberry Pi OS Lite, or a tty), where we talk to the display
# straight through the kernel's DRM/KMS interface.
if [ "$(uname -s)" = "Linux" ] && [ -z "${SDL_VIDEODRIVER:-}" ] \
   && [ -z "${WAYLAND_DISPLAY:-}" ] && [ -z "${DISPLAY:-}" ]; then
  export SDL_VIDEODRIVER=kmsdrm
fi

# Doom renders its frame in software anyway; the GPU is only used to scale
# it to the screen. On a Pi, the software scaler is the reliable default and
# still comfortably hits Doom's 35 fps. Set DOOM_RENDER=gpu to try the
# OpenGL ES path (Mesa from the Flox environment driving the Pi's V3D).
if [ -z "${SDL_RENDER_DRIVER:-}" ] && [ "${DOOM_RENDER:-auto}" != "gpu" ] && is_raspberry_pi; then
  export SDL_RENDER_DRIVER=software
fi

if ! command -v "$DOOM_PORT" >/dev/null 2>&1; then
  echo "doom: engine '$DOOM_PORT' is not in this environment (the manifest installs crispy-doom)" >&2
  exit 1
fi

exec "$DOOM_PORT" -iwad "$DOOM_IWAD" "$@"
