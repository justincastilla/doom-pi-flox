#!/usr/bin/env bash
# Headless proof that the environment is playable: verify the shareware
# WAD, then run its built-in demo through the engine with SDL's dummy
# video/audio drivers. This is what CI runs on x86_64 and arm64 runners,
# and what you run on the Pi before plugging in a screen.
#
#   flox activate -- smoke-test
set -euo pipefail

if [ -z "${FLOX_ENV:-}" ]; then
  echo "smoke-test: not inside the Flox environment. Run: flox activate -- smoke-test" >&2
  exit 1
fi

export SDL_VIDEODRIVER=dummy
export SDL_AUDIODRIVER=dummy
export HOME="$(mktemp -d)"
project="${FLOX_ENV_PROJECT:-$PWD}"
: "${DOOMWADPATH:=$project/wads}"
export DOOMWADPATH

# GNU `timeout` is not on macOS, so: run the command in the background and
# kill it if it is still there after $1 seconds. Returns the command's status.
run_with_timeout() {
  local secs=$1; shift
  "$@" &
  local pid=$!
  ( trap 'kill "$s" 2>/dev/null; exit 0' TERM
    sleep "$secs" & s=$!; wait "$s"
    kill "$pid" 2>/dev/null ) >/dev/null 2>&1 &
  local watchdog=$!
  wait "$pid"; local status=$?
  kill "$watchdog" 2>/dev/null
  return "$status"
}

echo "system:      $(uname -m) $(uname -s)"
echo "flox env:    $FLOX_ENV"
echo "wad path:    $DOOMWADPATH"
echo

fail=0

# The committed shareware IWAD must be id's v1.9 doom1.wad, byte for byte.
printf '%-16s ' "doom1.wad"
if [ -f "$project/wads/doom1.wad" ]; then
  if command -v md5sum >/dev/null 2>&1; then sum=$(md5sum "$project/wads/doom1.wad" | cut -d' ' -f1); else sum=$(md5 -q "$project/wads/doom1.wad"); fi
  if [ "$sum" = "f0cefca49926d00903cf57551d901abe" ]; then echo "OK   (id Software shareware v1.9, md5 verified)"; else echo "FAIL (md5 $sum)"; fail=1; fi
else
  echo "MISSING ($project/wads/doom1.wad)"; fail=1
fi

# -timedemo plays the IWAD's DEMO1 lump as fast as possible and exits.
# Doom has reported timedemo results through I_Error() since 1993, so the
# exit status is non-zero even on success; the "timed N gametics" line is
# the real verdict.
for iwad in doom1.wad; do
  for port in crispy-doom; do
    printf '%-16s ' "$port"
    printf '%-14s ' "$iwad"
    if ! command -v "$port" >/dev/null 2>&1; then
      echo "MISSING"; fail=1; continue
    fi
    out=$(run_with_timeout 120 "$port" -iwad "$iwad" -nosound -nomusic -window -timedemo demo1 2>&1 || true)
    if result=$(printf '%s\n' "$out" | grep -m1 -oE 'timed [0-9]+ gametics in [0-9]+ realtics \([0-9.]+ fps\)'); then
      echo "OK   ($result)"
    else
      echo "FAIL"; printf '%s\n' "$out" | tail -20; fail=1
    fi
  done
done

echo
if [ "$fail" -eq 0 ]; then
  echo "smoke-test: the engine ran the shareware demo. The environment is playable."
else
  echo "smoke-test: something failed, see output above." >&2
fi
exit "$fail"
