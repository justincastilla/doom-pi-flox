#!/usr/bin/env bash
# doom: play id Software's 1993 shareware DOOM (Episode 1, "Knee-Deep in the
# Dead"). Installed by the doom_share package as bin/doom (bin/doom_share is
# an alias).
#
#   flox run doom                    # E1M1, no environment needed
#   doom -warp 1 3 -skill 4          # any engine flag passes through
#   doom --engine <name>             # pick another engine (or set DOOMPORT)
#   doom --kiosk                     # booth mode: restart when a player quits
#
# The WAD lives in share/games/doom next to this script. This script names
# no engine; the package bundles one as a runtime dependency and any other
# on PATH works too. Engine lookup order:
#   1. --engine NAME, or DOOMPORT=NAME
#   2. an executable called "doom" on PATH that is not this script
#   3. the first executable on PATH whose name contains "doom"
set -euo pipefail

usage() { sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; }

# --- locate the WAD --------------------------------------------------------
# Inside a Flox environment the package is linked under $FLOX_ENV. Outside
# one (e.g. ./result-doom_share/bin/doom_share) resolve relative to this file.
resolve() {  # follow symlinks without readlink -f (not on older macOS)
  local p="$1" t
  while [ -L "$p" ]; do
    t="$(readlink "$p")"
    case "$t" in /*) p="$t" ;; *) p="$(dirname "$p")/$t" ;; esac
  done
  printf '%s\n' "$p"
}
self="$(resolve "$0")"
self_dir="$(cd "$(dirname "$self")" && pwd)"
self="$self_dir/$(basename "$self")"

wad_dir=""
if [ -n "${FLOX_ENV:-}" ] && [ -f "$FLOX_ENV/share/games/doom/doom1.wad" ]; then
  wad_dir="$FLOX_ENV/share/games/doom"
else
  wad_dir="$(cd "$self_dir/../share/games/doom" 2>/dev/null && pwd || true)"
fi
if [ ! -f "$wad_dir/doom1.wad" ]; then
  echo "doom: cannot find doom1.wad (looked in '$wad_dir')" >&2
  exit 1
fi
export DOOMWADPATH="$wad_dir${DOOMWADPATH:+:$DOOMWADPATH}"

# --- options ---------------------------------------------------------------
kiosk=0
engine="${DOOMPORT:-}"
while [ $# -gt 0 ]; do
  case "$1" in
    --kiosk)  kiosk=1; shift ;;
    --engine) engine="$2"; shift 2 ;;
    --engine=*) engine="${1#--engine=}"; shift ;;
    --help|-h) usage; exit 0 ;;
    --) shift; break ;;
    *) break ;;
  esac
done

is_self() {  # true if the candidate is this launcher (directly or via a symlink/wrapper)
  local r; r="$(resolve "$1")"
  [ "$r" = "$self" ] || [ "$(dirname "$r")" = "$self_dir" ] && case "$(basename "$r")" in doom|doom_share|.doom-wrapped|.doom_share-wrapped) return 0 ;; esac
  return 1
}
find_engine() {
  local dir f
  IFS=: read -ra dirs <<< "$PATH"
  for dir in "${dirs[@]}"; do
    f="$dir/doom"
    if [ -f "$f" ] && [ -x "$f" ] && ! is_self "$f"; then echo "$f"; return 0; fi
  done
  for dir in "${dirs[@]}"; do
    [ -d "$dir" ] || continue
    for f in "$dir"/*doom*; do
      [ -f "$f" ] && [ -x "$f" ] || continue
      case "$(basename "$f")" in
        doom|doom_share|*-setup|*-server) continue ;;   # handled above / setup tools / dedicated servers
      esac
      is_self "$f" && continue
      echo "$f"; return 0
    done
  done
  return 1
}

if [ -z "$engine" ]; then
  engine="$(find_engine || true)"
fi
if [ -z "$engine" ] || ! command -v "$engine" >/dev/null 2>&1; then
  cat >&2 <<MSG
doom: no Doom engine found on PATH.
The doom_share package bundles one, so this normally means the launcher was
copied out of the package. Install any Doom engine from the Flox catalog
(flox search doom) into the same environment, or point at one with
--engine NAME or DOOMPORT=NAME.
MSG
  exit 1
fi

# --- display defaults for a Linux console / Raspberry Pi -------------------
# Linux with no Wayland/X11 session (Raspberry Pi OS Lite, a tty): render
# straight through the kernel's DRM/KMS. SDL picks correctly everywhere else.
if [ "$(uname -s)" = "Linux" ] && [ -z "${SDL_VIDEODRIVER:-}" ] \
   && [ -z "${WAYLAND_DISPLAY:-}" ] && [ -z "${DISPLAY:-}" ]; then
  export SDL_VIDEODRIVER=kmsdrm
fi
# On a Raspberry Pi default to SDL's software scaler; Doom renders in
# software anyway. DOOM_SHARE_RENDER=gpu tries the OpenGL ES path instead.
if [ -z "${SDL_RENDER_DRIVER:-}" ] && [ "${DOOM_SHARE_RENDER:-auto}" != "gpu" ] \
   && [ -r /proc/device-tree/model ] \
   && tr -d '\0' < /proc/device-tree/model | grep -qi "raspberry pi"; then
  export SDL_RENDER_DRIVER=software
fi

# --- run -------------------------------------------------------------------
if [ "$kiosk" -eq 0 ]; then
  exec "$engine" -iwad doom1.wad "$@"
fi

# Kiosk: keep the game up. Config and saves go to a scratch HOME so a reset
# for the next player is `rm -rf ${DOOM_SHARE_HOME}`.
: "${DOOM_SHARE_HOME:=${XDG_STATE_HOME:-$HOME/.local/state}/doom_share-kiosk}"
: "${DOOM_SHARE_KIOSK_DELAY:=2}"
mkdir -p "$DOOM_SHARE_HOME"
export HOME="$DOOM_SHARE_HOME" XDG_CONFIG_HOME="$DOOM_SHARE_HOME/.config" XDG_DATA_HOME="$DOOM_SHARE_HOME/.local/share"
trap 'echo "doom: kiosk stopping"; exit 0' INT TERM
while :; do
  echo "doom: launching $engine (kiosk)"
  "$engine" -iwad doom1.wad -fullscreen "$@" || true
  echo "doom: engine exited, restarting in ${DOOM_SHARE_KIOSK_DELAY}s"
  sleep "$DOOM_SHARE_KIOSK_DELAY"
done
