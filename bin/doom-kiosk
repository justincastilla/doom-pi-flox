#!/usr/bin/env bash
# Booth mode: keep DOOM running. When a player quits (or the engine crashes),
# wait a moment and start it again. Ctrl-C on the controlling terminal, or
# `systemctl stop doom-kiosk`, ends the loop.
#
#   flox activate -- doom-kiosk
#
# Extra arguments are passed to every launch, e.g.
#   flox activate -- doom-kiosk -skill 3 -warp 1 1
set -uo pipefail

: "${DOOM_KIOSK_DELAY:=2}"
: "${DOOM_KIOSK_HOME:=${FLOX_ENV_PROJECT:-$PWD}/.doom-home}"

# Keep config and savegames out of the real home directory, so a reset for
# the next attendee is just `rm -rf .doom-home`.
mkdir -p "$DOOM_KIOSK_HOME"
export HOME="$DOOM_KIOSK_HOME"
export XDG_CONFIG_HOME="$DOOM_KIOSK_HOME/.config"
export XDG_DATA_HOME="$DOOM_KIOSK_HOME/.local/share"

trap 'echo "doom-kiosk: stopping"; exit 0' INT TERM

while :; do
  echo "doom-kiosk: launching ${DOOM_PORT:-crispy-doom} with ${DOOM_IWAD:-doom1.wad}"
  doom -fullscreen "$@"
  status=$?
  echo "doom-kiosk: engine exited with status $status, restarting in ${DOOM_KIOSK_DELAY}s"
  sleep "$DOOM_KIOSK_DELAY"
done
