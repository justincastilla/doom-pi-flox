# DOOM kiosk: boot the Raspberry Pi straight into the game on tty1.
#
# Install (as the user that cloned the repo, here assumed to be "pi" with the
# checkout at /home/pi/doom-pi-flox; adjust the three paths and User= if not):
#
#   sudo cp systemd/doom-kiosk.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now doom-kiosk
#
# Stop it (and get your console back):  sudo systemctl stop doom-kiosk
# Logs:                                 journalctl -u doom-kiosk -f
#
# The unit runs `flox activate` non-interactively; the environment's hook sets
# up PATH and DOOMWADPATH exactly as it does for a human at a shell.
[Unit]
Description=DOOM kiosk (Flox environment)
After=multi-user.target systemd-user-sessions.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=pi
Group=pi
SupplementaryGroups=video render input audio
WorkingDirectory=/home/pi/doom-pi-flox
Environment=HOME=/home/pi
# No compositor on tty1: render straight through the kernel's KMS/DRM.
Environment=SDL_VIDEODRIVER=kmsdrm
# Uncomment if audio is silent on the console (PipeWire/Pulse only run inside a login session).
#Environment=SDL_AUDIODRIVER=alsa
ExecStart=/usr/bin/flox activate --dir /home/pi/doom-pi-flox -- doom-kiosk
Restart=always
RestartSec=3
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

[Install]
WantedBy=multi-user.target
